# Copy to .env.local. Never commit real values.
DATABASE_URL=postgresql://chronicle:password@localhost:5432/chronicle
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Localhost PostgreSQL uses plaintext by default; remote databases use verified TLS.
# Set DATABASE_SSL=false only when your trusted database network requires plaintext.
# DATABASE_SSL=false
# An explicit compatibility escape hatch for providers with private/self-signed CAs:
# prefer installing the CA instead of disabling certificate verification.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Optional Telegram bot integration. All three values are required for linking.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TG_WEBHOOK_SECRET=
# Required only when a scheduler invokes /api/cron/notify.
CRON_SECRET=
